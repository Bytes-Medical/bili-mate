{
  "name": "bili-mate-web",
  "version": "0.1.0",
  "private": true,
  "description": "Bili Mate reference web client (spec 06). Static export; no clinical logic in the browser.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-csp.mjs",
    "start": "serve out",
    "generate:api": "openapi-typescript ../spec/openapi.yaml -o lib/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "luxon": "^3.5.0",
    "next": "^15.3.0",
    "openapi-fetch": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/luxon": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "openapi-typescript": "^7.5.0",
    "serve": "^14.2.0",
    "typescript": "^5.7.0"
  }
}
